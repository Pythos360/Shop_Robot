#include <Arduino.h>

// --- Pins & timing ---
const uint8_t STEP_PIN = 5;    // STEP / MA
const uint16_t on_us = 5;      // pulse HIGH width
int off_us = 800;              // pulse LOW width (sets speed)

// --- Protocol sizes (match your sender) ---
#define AXES_N   8
#define BTNS_N   11

// --- State ---
float a_values[AXES_N]  = {0};
int   b_values[BTNS_N]  = {0};
int   b_prev[BTNS_N]    = {0};
bool  step_high = false;
unsigned long next_toggle_us = 0;

#define LINE_BUF 200
char linebuf[LINE_BUF];

// --- Utils ---
static inline void clampOffUs() {
  if (off_us < 100)  off_us = 100;   // faster limit
  if (off_us > 5000) off_us = 5000;  // slower limit
}

static inline void trimTail(char* s) {
  int n = strlen(s);
  while (n && (s[n-1] == '\r' || s[n-1] == ' ' || s[n-1] == '\t')) s[--n] = 0;
}

static int parseCSVfloats(char* csv, float* out, int maxn) {
  int i = 0;
  char* tok;
  while ((tok = strsep(&csv, ",")) && i < maxn) {
    out[i++] = (*tok) ? atof(tok) : 0.0f;
  }
  return i;
}
static int parseCSVints(char* csv, int* out, int maxn) {
  int i = 0;
  char* tok;
  while ((tok = strsep(&csv, ",")) && i < maxn) {
    out[i++] = (*tok) ? (int)strtol(tok, nullptr, 10) : 0;
  }
  return i;
}

static bool parseFrame(char* line) {
  // Expect: A:<floats>;B:<ints>
  char* A = strstr(line, "A:");
  char* B = strstr(line, "B:");
  if (!A || !B) return false;

  // isolate A section
  A += 2;
  char* semi = strchr(A, ';');
  if (!semi) return false;
  *semi = 0;               // A csv is now A[0..semi-1]
  char* csvA = A;

  // B section is after "B:"
  B += 2;
  char* csvB = B;

  // parse
  parseCSVfloats(csvA, a_values, AXES_N);
  parseCSVints(csvB,   b_values, BTNS_N);

  // restore (optional)
  *semi = ';';
  return true;
}

void setup() {
  pinMode(STEP_PIN, OUTPUT);
  digitalWrite(STEP_PIN, LOW);
  Serial.begin(115200);
  // while (!Serial) {;} // not needed on Uno

  Serial.println(F("Ready: A:<8 floats>;B:<11 ints>"));
}

void handleButtonsEdgeActions() {
  // Rising edge helpers
  auto rose = [&](int idx){ return (b_prev[idx]==0 && b_values[idx]==1); };

  // NOTE: smaller off_us => faster; larger => slower
  if (rose(4)) { off_us += 100; }  // b[4] makes it SLOWER
  if (rose(5)) { off_us -= 100; }  // b[5] makes it FASTER
  clampOffUs();

  // Save current buttons for next edge detection
  for (int i = 0; i < BTNS_N; ++i) b_prev[i] = b_values[i];
}

void driveMotor() {
  bool enabled = (b_values[0] == 1);  // run when A (index 0) held
  unsigned long now = micros();

  if (!enabled) {
    if (step_high) {
      digitalWrite(STEP_PIN, LOW);
      step_high = false;
    }
    next_toggle_us = now;
    return;
  }

  if ((long)(now - next_toggle_us) >= 0) {
    if (step_high) {
      digitalWrite(STEP_PIN, LOW);
      step_high = false;
      next_toggle_us = now + (unsigned long)off_us;
    } else {
      digitalWrite(STEP_PIN, HIGH);
      step_high = true;
      next_toggle_us = now + (unsigned long)on_us;
    }
  }
}

void loop() {
  // Read one line (non-blocking-ish)
  if (Serial.available()) {
    size_t n = Serial.readBytesUntil('\n', linebuf, LINE_BUF - 1);
    linebuf[n] = 0;
    trimTail(linebuf);

    if (n) {
      if (strcmp(linebuf, "dump") == 0) {
        Serial.print(F("off_us=")); Serial.println(off_us);
        Serial.print(F("A:"));
        for (int i=0;i<AXES_N;i++){ Serial.print(a_values[i],3); if(i<AXES_N-1)Serial.print(','); }
        Serial.print(F("\nB:"));
        for (int i=0;i<BTNS_N;i++){ Serial.print(b_values[i]); if(i<BTNS_N-1)Serial.print(','); }
        Serial.println();
      } else if (parseFrame(linebuf)) {
        handleButtonsEdgeActions(); // only once per fresh B frame
      }
    }
  }

  driveMotor();
}
